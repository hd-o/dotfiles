{
  "default_agent": "plan",
  "websearch": {
    "provider": "exa"
  },
  "permissions": [
    {
      "action": "*",
      "resource": "*",
      "effect": "allow"
    }
  ],
  "agents": {
    "plan": {
      "model": "opencode-go/mimo-v2.6-pro"
    },
    "build": {
      "model": "opencode-go/muse-spark-1.3-contributor#high"
    },
    "general": {
      "model": "opencode-go/muse-spark-1.3-contributor#high",
      "system": "{file:~/dotfiles/dev/opencode/prompts/general.md}"
    },
    "explore": {
      "model": "opencode-go/muse-spark-1.3-contributor#minimal"
    }
  }
}
