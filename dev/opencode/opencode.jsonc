{
  "default_agent": "plan",
  "websearch": {
    "provider": "exa"
  },
  "permissions": [
    {
      "action": "*",
      "resource": "*",
      "effect": "allow"
    }
  ],
  "agents": {
    "plan": {
      "model": "openai/gpt-6-sol#high"
    },
    "build": {
      "model": "opencode-go/glm-5.3-flash#max"
    },
    "general": {
      "model": "opencode-go/glm-5.3-flash#max",
      "system": "{file:~/dotfiles/dev/opencode/prompts/general.md}"
    },
    "explore": {
      "model": "opencode-go/muse-spark-1.3-contributor#minimal"
    }
  }
}
