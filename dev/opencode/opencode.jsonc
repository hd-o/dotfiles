{
  "$schema": "https://opencode.ai/config.json",
  "default_agent": "plan",
  "permission": "allow",
  "agent": {
    "plan": {
      "model": "opencode-go/mimo-v2.6-pro",
    },
    "build": {
      "model": "opencode/muse-spark-1.3-contributor-free",
      "variant": "xhigh"
    },
    "general": {
      "model": "opencode/muse-spark-1.3-contributor-free",
      "variant": "xhigh",
      "prompt": "{file:~/dotfiles/dev/opencode/prompts/general.md}"
    },
    "explore": {
      "model": "opencode/muse-spark-1.3-contributor-free",
      "variant": "minimal"
    },
  }
}
