{
  "$schema": "https://opencode.ai/config.json",
  "default_agent": "plan",
  "permission": "allow",
  "small_model": "opencode/minimax-m3-free",
  "agent": {
    "plan": {
      "model": "opencode-go/muse-spark-1.3-contributor",
      "variant": "high"
    },
    "build": {
      "model": "opencode-go/muse-spark-1.3-contributor",
      "variant": "medium"
    },
    "general": {
      "model": "opencode-go/muse-spark-1.3-contributor",
      "variant": "medium"
    },
    "explore": {
      "model": "opencode-go/muse-spark-1.3-contributor",
      "variant": "low"
    },
  }
}
