{
  "websearch": {
    "provider": "exa"
  },
  "permissions": [
    {
      "action": "*",
      "resource": "*",
      "effect": "allow"
    }
  ],
  "experimental": {
    "subagent_depth": 2
  },
  "compaction": {
    "auto": true,
    "keep": {
      "tokens": 24000
    }
  },
  "providers": {
    "openai": {
      "models": {
        "gpt-5.6-sol-fast": {
          "limit": {
            "context": 500000,
            "input": 500000,
            "output": 128000
          }
        }
      }
    }
  },
  "agents": {
    "plan": {
      "model": "openai/gpt-6-astra#high"
    },
    "build": {
      "model": "openai/gpt-5.6-sol-fast#high"
    },
    "general": {
      "model": "openai/gpt-5.6-sol-fast#high",
      "system": "{file:~/dotfiles/dev/opencode/system/general.md}",
      "permissions": [
        {
          "action": "subagent",
          "resource": "*",
          "effect": "allow"
        }
      ]
    },
    "explore": {
      "model": "opencode-go/muse-spark-1.3-contributor#low",
      "description": "{file:~/dotfiles/dev/opencode/description/explore.md}"
    },
    "review": {
      "mode": "subagent",
      "description": "Invoke when using subagent-review skill",
      "system": "# Review Subagent",
      "model": "openai/gpt-5.6-sol-fast#high"
    }
  }
}
