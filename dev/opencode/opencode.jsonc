{
  "$schema": "https://opencode.ai/config.json",
  "subagent_depth": 2,
  "permission": "allow",
  "plugin": [
    "openguardrails-instrumentation-opencode"
  ],
  "mcp": {
    "linear": {
      "enabled": false,
      "type": "local",
      "command": [
        "npx",
        "-y",
        "mcp-remote",
        "https://mcp.linear.app/sse"
      ],
    },
    "playwright": {
      "enabled": false,
      "type": "local",
      "command": [
        "npx",
        "-y",
        "@playwright/mcp@latest",
        "--isolated",
        "--browser=chromium"
      ],
    },
    "task-master-ai": {
      "enabled": false,
      "type": "local",
      "command": [
        "npx",
        "-y",
        "--package=task-master-ai",
        "task-master-ai"
      ],
    },
  },
}
