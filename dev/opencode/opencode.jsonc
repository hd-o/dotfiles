    "build": {
      "model": "opencode-go/deepseek-v4.1-flash",
      "variant": "high"
    },
    "general": {
      "model": "opencode-go/deepseek-v4.1-flash",
      "variant": "high"
    },
    "explore": {
      "model": "opencode/muse-spark-1.3-contributor-free",
      "variant": "low"
    },
  }
}
