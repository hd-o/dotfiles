{
  "default_agent": "build",
  "websearch": {
    "provider": "exa"
  },
  "permissions": [
    {
      "action": "*",
      "resource": "*",
      "effect": "allow"
    }
  ],
  "agents": {
    "plan": {
      "model": "openai/gpt-6-sol#high"
    },
    "build": {
      "model": "opencode-go/glm-5.3-flash"
    },
    "general": {
      "model": "opencode-go/glm-5.3-flash",
      "system": "{file:~/dotfiles/dev/opencode/prompts/general.md}"
    },
    "explore": {
      "model": "opencode-go/muse-spark-1.3-contributor#low"
    },
    "review": {
      "mode": "subagent",
      "description": "Invoke when using subagent-review skill",
      "system": "# Review Subagent",
      "model": "openai/gpt-6-sol#medium"
    },
    "Manage": {
      "mode": "primary",
      "system": "{file:~/.agents/commands/x-implement/SKILL.md}",
      "model": "openai/gpt-6-sol#high"
    }
  }
}
